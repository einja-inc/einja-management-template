# .env.local（暗号化）から復号された .env を読み込み
dotenv_if_exists .env

# 個人用トークン（メインワークツリーから読み込み）
# git worktree list --porcelain でメインワークツリー（bareでないもの）を特定
get_main_worktree() {
  local current_worktree=""
  while IFS= read -r line; do
    if [[ "$line" == "worktree "* ]]; then
      current_worktree="${line#worktree }"
    elif [[ "$line" == "bare" ]]; then
      # bareリポジトリはスキップ
      current_worktree=""
    elif [[ -z "$line" && -n "$current_worktree" ]]; then
      # 空行 = ブロック終了、bareでなければメインワークツリー
      echo "$current_worktree"
      return
    fi
  done < <(git worktree list --porcelain 2>/dev/null)
  # 最後のブロックがbareでなければ出力
  if [[ -n "$current_worktree" ]]; then
    echo "$current_worktree"
  fi
}

MAIN_WORKTREE=$(get_main_worktree)
if [ -n "$MAIN_WORKTREE" ] && [ -f "$MAIN_WORKTREE/.env.personal" ]; then
  dotenv_if_exists "$MAIN_WORKTREE/.env.personal"
fi
