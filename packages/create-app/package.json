{
  "name": "@einja-inc/create-app",
  "version": "0.3.8",
  "description": "CLI tool to create new projects with Einja Management Template",
  "type": "module",
  "bin": {
    "create-einja-app": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "prebuild": "pnpm template:update",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "pretest": "test -d ./templates/default || pnpm template:update",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "template:update": "tsx scripts/template-update.ts",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "fs-extra": "^11.2.0",
    "glob": "^11.0.0",
    "ignore": "^7.0.0",
    "inquirer": "^12.0.0",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.7.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/einja-inc/einja-management-template.git",
    "directory": "packages/create-app"
  },
  "keywords": [
    "einja",
    "cli",
    "template",
    "turborepo",
    "nextjs"
  ],
  "license": "UNLICENSED"
}
