{
  "extends": "@repo/config/typescript",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@web/*": ["./src/*", "./*"],
      "@/styled-system/*": ["./styled-system/*"],
      "styled-system/*": ["./styled-system/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "vitest.d.ts",
    "test/matchers.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "server/**/*.ts",
    ".next/types/**/*.ts",
    "../../packages/front-core/src/auth/types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"]
}
