{
	"mcpServers": {
		"codex": {
			"type": "stdio",
			"command": "codex",
			"args": [
				"mcp-server"
			]
		},
		"context7": {
			"command": "npx",
			"args": [
				"-y",
				"@upstash/context7-mcp"
			]
		},
		"playwright": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@playwright/mcp",
				"--isolated"
			]
		},
		"serena": {
			"type": "stdio",
			"command": "bash",
			"args": [
				"-lc",
				"$(git rev-parse --show-toplevel)/scripts/serena-mcp-bridge.sh"
			]
		},
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/",
			"headers": {
				"Authorization": "Bearer ${GITHUB_TOKEN}"
			}
		},
		"drawio": {
			"command": "npx",
			"args": [
				"-y",
				"@drawio/mcp@latest"
			]
		},
		"nano-banana": {
			"command": "npx",
			"args": [
				"-y",
				"nano-banana-mcp"
			],
			"env": {
				"GEMINI_API_KEY": "${NANOBANANA_MCP_GEMINI_API_KEY}"
			}
		}
	}
}
