{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_MEM_DATA_DIR": ".claude-mem",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Bash(npm *)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(bun *)",
      "Bash(npx *)",
      "Bash(turbo *)",
      "Bash(mise *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(node *)",
      "Bash(python3 *)",
      "Bash(tsc *)",
      "Bash(tsx *)",
      "Bash(biome *)",
      "Bash(vitest *)",
      "Bash(playwright *)",
      "Bash(prisma *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(docker compose *)",
      "Bash(vercel *)",
      "Bash(supabase *)",
      "Bash(claude *)",
      "Bash(tmux *)",
      "Bash(open *)",
      "Bash(ls *)",
      "Bash(cd *)",
      "Bash(pwd *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(echo *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(unzip *)",
      "Bash(jq *)",
      "Bash(pkill -f *)",
      "WebFetch",
      "WebFetch(domain:*)",
      "WebSearch",
      "LS(*)",
      "Read(**)",
      "Read(//private/tmp/**)",
      "Glob(*)",
      "Grep(*)",
      "Edit(**)",
      "MultiEdit(**)",
      "Write",
      "Task(*)",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskUpdate",
      "TaskOutput",
      "TaskStop",
      "Skill",
      "Skill(*)",
      "AskUserQuestion",
      "NotebookRead(*)",
      "NotebookEdit(*)",
      "EnterPlanMode",
      "ExitPlanMode",
      "EnterWorktree",
      "ExitWorktree",
      "TeamCreate",
      "TeamDelete",
      "SendMessage",
      "Monitor",
      "PushNotification",
      "CronCreate",
      "CronList",
      "CronDelete",
      "RemoteTrigger",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "mcp__codex__*",
      "mcp__github__*",
      "mcp__playwright__*",
      "mcp__pencil__*",
      "mcp__serena__*",
      "mcp__context7__*",
      "mcp__n8n-mcp__*",
      "mcp__drawio__*",
      "mcp__nano-banana__*",
      "mcp__plugin_einja-common_playwright__*",
      "mcp__plugin_einja-common_pencil__*",
      "mcp__plugin_einja-common_Figma__*",
      "mcp__claude_ai_Figma__*",
      "mcp__claude_ai_Asana__*",
      "mcp__claude_ai_Gmail__*",
      "mcp__claude_ai_Google_Calendar__*",
      "mcp__claude_ai_Google_Drive__*",
      "mcp__claude_ai_Notion__*",
      "mcp__claude_ai_Zapier__*",
      "mcp__claude_ai_Draw_io_MCP__*"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(rm *)",
      "Bash(sudo *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(killall *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__playwright__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/einja/playwright-resize.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/einja/biome-format.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/einja/detect-secrets.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/einja/large-file-warning.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/einja/design-doc-check.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/einja/typecheck.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/einja/warn-index-ts.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/einja/plan-mode-skill-loader.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/einja/teammate-idle.sh"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/einja/task-completed.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "claude-mem@thedotmack": true,
    "einja-dev@einja-skills": true
  },
  "extraKnownMarketplaces": {
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "einja-skills": {
      "source": {
        "source": "github",
        "repo": "einja-inc/einja-skills"
      }
    }
  }
}
