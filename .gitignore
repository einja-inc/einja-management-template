# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Python
**/__pycache__/

# auto-generated files
**/__generated__/

# dependencies
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
**/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# dev server logs
log/*.log
log/*.pid

# env files
.env
.env.personal
.env.keys
.env.local.tmp
.env.*.bak
.env.keys.bak

# dotenvx - 以下は追跡する（暗号化済み）
# .env.example（テンプレート）
# .env.personal.example（個人用テンプレート）
# .env.local（ローカル開発用・暗号化済み）
# .env.develop（dev検証環境・暗号化済み）
# .env.staging（ステージング・暗号化済み）
# .env.production（本番・暗号化済み）
# .env.ci（CI/CD・暗号化済み）

# vercel
.vercel

# turborepo
.turbo

# typescript
*.tsbuildinfo
next-env.d.ts

# package build outputs
packages/config/dist
packages/cli/dist

## Panda
styled-system
styled-system-studio
*storybook.log
storybook-static

