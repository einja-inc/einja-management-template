{
  "name": "@einja-inc/dev-cli",
  "version": "0.1.58",
  "description": "Einja CLI - .claude設定とテンプレート同期をnpxでインストール",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "einja": "./dist/cli.js"
  },
  "files": [
    "dist",
    "presets",
    "scaffolds"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prebuild": "node ./scripts/generate-template.mjs && node ./scripts/copy-presets.mjs",
    "build": "pnpm clean && tsc && tsc-alias",
    "postbuild": "node ./scripts/add-shebang.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "format": "biome format ./src",
    "pretest": "test -d ./presets/default/.claude || (node ./scripts/generate-template.mjs && node ./scripts/copy-presets.mjs)",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "preset:update": "tsx ../../scripts/_cli-template-update.ts",
    "scaffold:update": "tsx ../../scripts/_template-update.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.0",
    "ignore": "^7.0.3",
    "inquirer": "^12.6.0",
    "js-yaml": "^4.1.0",
    "node-diff3": "^3.2.0",
    "ora": "^8.2.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@repo/config": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.18.13",
    "tsc-alias": "^1.8.16",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/einja-inc/einja-management-template.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "einja",
    "atdd"
  ],
  "license": "UNLICENSED"
}
