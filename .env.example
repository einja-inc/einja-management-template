# ============================================
# 環境変数テンプレート
# ============================================
# このファイルは以下の用途で使用します:
#   1. ローカル開発: pnpm dev が .env を再生成する際のベース
#   2. デプロイ環境: .env.develop, .env.staging, .env.production 等の作成ベース
#
# 【ローカル開発のファイル構成】
#   .env.local（暗号化・Git共有）→ チーム共有の秘密情報
#        ↓ pnpm dev で自動復号
#   .env（作業用・毎回再生成）← このテンプレートがベース
#        +
#   .env.personal（個人トークン）→ 個人の秘密情報
#
# 詳細: docs/einja/steering/infrastructure/environment-variables.md
# ============================================

# ────────────────────────────────────────────
# 共通（全環境で必要）
# ────────────────────────────────────────────

# NextAuth設定
AUTH_SECRET=your-nextauth-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# OAuth設定（必要に応じて有効化）
# AUTH_GOOGLE_ID=your-google-client-id
# AUTH_GOOGLE_SECRET=your-google-client-secret
# AUTH_GITHUB_ID=your-github-client-id
# AUTH_GITHUB_SECRET=your-github-client-secret

# データベース設定
# ローカル: docker-compose の PostgreSQL（pnpm dev で自動設定）
# デプロイ: Neon 等の接続文字列に置き換え（例: postgresql://<user>:<pass>@<host>/<db>?sslmode=require）
DATABASE_URL="postgresql://postgres:postgres@localhost:25432/main?schema=public"

# ────────────────────────────────────────────
# ローカル開発専用
# ────────────────────────────────────────────

# アプリケーションポート（複数アプリ対応）
# pnpm dev 実行時にブランチ名から自動計算されます
# PORT_WEB=3000
# PORT_ADMIN=4000
