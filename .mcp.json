{
	"mcpServers": {
		"vibe_kanban": {
			"command": "npx",
			"args": [
				"-y",
				"vibe-kanban@latest",
				"--mcp"
			]
		},
		"codex": {
			"type": "stdio",
			"command": "codex",
			"args": [
				"mcp-server"
			]
		},
		"context7": {
			"command": "npx",
			"args": [
				"-y",
				"@upstash/context7-mcp"
			]
		},
		"playwright": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@playwright/mcp",
				"--isolated"
			]
		},
		"serena": {
			"type": "http",
			"url": "http://127.0.0.1:${SERENA_PORT:-9850}/mcp"
		},
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/",
			"headers": {
				"Authorization": "Bearer ${GITHUB_TOKEN}"
			}
		},
		"drawio": {
			"command": "npx",
			"args": [
				"-y",
				"@drawio/mcp@latest"
			]
		}
	}
}